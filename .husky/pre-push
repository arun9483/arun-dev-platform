pnpm lint
pnpm typecheck
# Affected tests only — packages changed relative to origin/main (turbo cache covers the rest).
pnpm exec turbo run test --filter='...[origin/main]'

# Non-blocking reminder: /preflight (Claude Code) writes .git/preflight-stamp on completion.
stamp=.git/preflight-stamp
head_time=$(git log -1 --format=%ct 2>/dev/null || echo 0)
stamp_time=0
if [ -f "$stamp" ]; then
  stamp_time=$(stat -f %m "$stamp" 2>/dev/null || stat -c %Y "$stamp" 2>/dev/null || echo 0)
fi
if [ "$stamp_time" -lt "$head_time" ]; then
  echo "i Preflight not run since last commit — consider running /preflight in Claude Code."
fi
