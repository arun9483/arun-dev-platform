{
  "name": "@arun-dev/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "clean": "rm -rf .next .turbo",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:unit": "vitest run --passWithNoTests --coverage --config vitest.unit.config.ts",
    "test:integration": "vitest run --passWithNoTests --coverage --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "perf:size": "size-limit"
  },
  "dependencies": {
    "@arun-dev/tokens": "0.1.0",
    "@arun-dev/ui": "0.1.0",
    "gray-matter": "4.0.3",
    "mermaid": "11.15.0",
    "minisearch": "7.1.1",
    "next": "16.2.11",
    "next-mdx-remote": "6.0.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remark-gfm": "4.0.1",
    "sugar-high": "1.2.0"
  },
  "devDependencies": {
    "@arun-dev/config": "workspace:*",
    "@axe-core/playwright": "4.11.3",
    "@playwright/test": "1.58.2",
    "@size-limit/file": "12.1.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.19.15",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "3.2.6",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "jsdom": "29.0.1",
    "size-limit": "12.1.0",
    "typescript": "5.9.3",
    "vitest": "3.2.6"
  }
}
