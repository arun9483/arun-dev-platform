{
  "name": "arun-dev-platform",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "turbo run dev",
    "start": "turbo run start",
    "clean": "turbo run clean",
    "clean:all": "turbo run clean && rm -rf .turbo node_modules apps/*/node_modules packages/*/node_modules",
    "clean:build": "turbo run clean && turbo run build",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e --",
    "perf:size": "pnpm --filter @arun-dev/web run perf:size",
    "quality:knip": "knip",
    "quality:dupes": "jscpd apps packages",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "20.5.0",
    "@commitlint/config-conventional": "20.5.0",
    "@commitlint/types": "20.5.0",
    "@playwright/mcp": "0.0.75",
    "eslint": "9.39.4",
    "husky": "9.1.7",
    "jscpd": "5.0.8",
    "knip": "6.16.1",
    "lint-staged": "16.4.0",
    "prettier": "3.8.1",
    "turbo": "2.9.14",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.32.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "playwright-core": "1.58.2",
      "picomatch@2": "2.3.2",
      "picomatch@4": "4.0.4",
      "vite@7": "7.3.5",
      "fast-uri@3": "3.1.4",
      "brace-expansion@5": "5.0.8",
      "brace-expansion@1": "1.1.16",
      "brace-expansion@2": "2.1.2",
      "postcss@8": "8.5.18",
      "yaml@2": "2.8.3",
      "js-yaml@3": "3.15.0",
      "js-yaml@4": "4.3.0",
      "undici@7": "7.28.0",
      "dompurify@3": "3.4.12",
      "@babel/core@7": "7.29.7",
      "esbuild@0.27": "0.28.1",
      "sharp": "0.35.0"
    }
  }
}
